# Keep the build context small and free of secrets/host artifacts.
.git
.gitignore
node_modules
dist
npm-debug.log*
*.log
.nx
tmp
coverage

# Secrets and local config must never enter the build context or an image layer.
.env
.env.*
!.env.example

# Dev-only files and caches
.vscode
.idea
.agents
.claude
.codex
.gemini
.opencode
*.md
!README.md
docker-compose*.yml
Dockerfile*
.dockerignore
.prettierrc*
.prettierignore
