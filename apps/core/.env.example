# Core Service Configuration (Required)
HOST=0.0.0.0
PORT=8080

# Git Provider Adapter URL (Required)
GIT_ADAPTER_URL=http://adapter:8080

# Pub/Sub Configuration (Required)
PR_EVENTS_SUBSCRIPTION=pr-events-sub
REVIEW_RESULTS_TOPIC=review-results

# AI Review Model (Required)
REVIEW_MODEL=gemini-3.8-flash

# Optional: Google Cloud Project & Gemini API Key
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GEMINI_API_KEY=your-gemini-api-key

# Optional: Local Firestore and Pub/Sub Emulators
# FIRESTORE_EMULATOR_HOST=localhost:8081
# PUBSUB_EMULATOR_HOST=localhost:8085
