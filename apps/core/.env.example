# Core Service Configuration
HOST=0.0.0.0
PORT=8080

# URL of the Gateway service for posting reviews back to Git providers
GATEWAY_URL=http://gateway:8080

# Shared secret token for authenticating ConnectRPC and internal Pub/Sub push callbacks
PUBSUB_SECRET_TOKEN=your-internal-secret-token

# Google Cloud Pub/Sub Topic Names
BUILD_CONTEXT_TOPIC=build-context-topic
CONTEXT_READY_TOPIC=context-ready-topic
REVIEW_CODE_TOPIC=review-code-topic
REVIEW_RESULT_TOPIC=review-result-topic

# Optional: Google Cloud Project ID (if not running in GCP compute environment)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Local Firestore and Pub/Sub Emulators
# FIRESTORE_EMULATOR_HOST=localhost:8081
# PUBSUB_EMULATOR_HOST=localhost:8085
