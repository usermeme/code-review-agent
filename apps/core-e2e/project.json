{
  "name": "core-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/core-e2e/src",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cucumber-js --config apps/core-e2e/cucumber.json",
        "env": {
          "NODE_OPTIONS": "--import tsx",
          "HOST": "0.0.0.0",
          "PORT": "8080",
          "GIT_ADAPTER_URL": "http://adapter:8080",
          "REVIEW_RESULTS_TOPIC": "test-review-results-topic",
          "REVIEW_MODEL": "gemini-3.8-flash"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/core-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/core-e2e/tsconfig.json --noEmit"
      }
    }
  },
  "tags": []
}
