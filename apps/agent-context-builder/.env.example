# Context Builder Agent Configuration
PORT=8080

# URL of the Core service for storing/fetching synthesized repository context
CORE_URL=http://core:8080

# Google Gemini model for chunk analysis and context synthesis
REVIEW_MODEL=gemini-2.5-flash

# Google Gemini API Key (or use ADC / Vertex AI in GCP)
GEMINI_API_KEY=AIzaSy...

# Google Cloud Pub/Sub topic to notify when context synthesis is complete
CONTEXT_READY_TOPIC=context-ready-topic

# Optional: Set to 1 to use Vertex AI instead of Google AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=0

# Optional: Local Pub/Sub Emulator
# PUBSUB_EMULATOR_HOST=localhost:8085
# PUBSUB_PROJECT_ID=local-project
