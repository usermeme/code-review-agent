{
  "name": "github-adapter-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/github-adapter-e2e/src",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cucumber-js --config apps/github-adapter-e2e/cucumber.json",
        "env": {
          "NODE_OPTIONS": "--import tsx",
          "HOST": "0.0.0.0",
          "PORT": "8080",
          "GITHUB_TOKEN": "test-github-token"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/github-adapter-e2e"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/github-adapter-e2e/tsconfig.json --noEmit"
      }
    }
  },
  "tags": ["type:e2e"]
}
