# Code Reviewer Agent Configuration
PORT=8080
HOST=0.0.0.0

# URL of the Core service for retrieving context and review fallbacks
CORE_URL=http://core:8080

# Google Gemini model for code review and inline comments
REVIEW_MODEL=gemini-2.5-flash

# Google Gemini API Key (or use ADC / Vertex AI in GCP)
GEMINI_API_KEY=AIzaSy...

# Google Cloud Pub/Sub topic to publish review findings to
REVIEW_RESULT_TOPIC=review-result-topic

# Shared secret token for authenticating direct HTTP fallback to Core
INTERNAL_AUTH_TOKEN=your-internal-secret-token

# Optional: Set to 1 to use Vertex AI instead of Google AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=0

# Optional: Local Pub/Sub Emulator
# PUBSUB_EMULATOR_HOST=localhost:8085
# PUBSUB_PROJECT_ID=local-project
