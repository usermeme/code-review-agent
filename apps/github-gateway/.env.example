# GitHub Gateway Service Configuration (Stateless, No DB)
HOST=0.0.0.0
PORT=8080

# URL of the Core service for ingesting PR events via ConnectRPC
CORE_URL=http://core:8080

# GitHub Webhook Secret and Personal Access Token (with repo scope)
GIT_ADAPTER_WEBHOOK_SECRET=your-random-webhook-secret
GIT_ADAPTER_TOKEN=ghp_your_github_access_token

# Shared secret token for authenticating ConnectRPC and internal push callbacks
PUBSUB_SECRET_TOKEN=your-internal-secret-token
