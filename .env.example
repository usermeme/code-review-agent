# ==============================================================================
# Code Review Agent - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# GitHub Gateway Service Configuration (Stateless, No DB)
# ------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
CORE_URL=http://core:8080

# Git Provider Configuration (currently supported: github)
GIT_ADAPTER=github
GIT_ADAPTER_WEBHOOK_SECRET=your-random-webhook-secret
GIT_ADAPTER_TOKEN=ghp_your_github_access_token

# Shared secret token for internal RPC and Pub/Sub callbacks
PUBSUB_SECRET_TOKEN=your-internal-secret-token

# ------------------------------------------------------------------------------
# Core Service Configuration (Firestore DB & Workflow Orchestration)
# ------------------------------------------------------------------------------
GATEWAY_URL=http://gateway:8080

# Google Cloud Pub/Sub Topic Names
BUILD_CONTEXT_TOPIC=build-context-topic
CONTEXT_READY_TOPIC=context-ready-topic
REVIEW_CODE_TOPIC=review-code-topic
REVIEW_RESULT_TOPIC=review-result-topic

# Google Cloud Project (Optional if running inside GCP compute environment)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ------------------------------------------------------------------------------
# AI Agents Configuration (Context Builder & Code Reviewer)
# ------------------------------------------------------------------------------
REVIEW_MODEL=gemini-2.5-flash

# Google Gemini API Key (for Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# Set to 1 to use Google Cloud Vertex AI instead of Google AI Studio API key
GOOGLE_GENAI_USE_VERTEXAI=0

# ------------------------------------------------------------------------------
# Local Development & Emulators (Optional)
# ------------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=localhost:8081
# PUBSUB_EMULATOR_HOST=localhost:8085
