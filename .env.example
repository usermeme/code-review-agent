# ==============================================================================
# Code Review Agent - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Common Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# GitHub Ingress Service (apps/github-ingress)
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=your-random-webhook-secret
PR_EVENTS_TOPIC=pr-events

# ------------------------------------------------------------------------------
# GitHub Adapter Service (apps/github-adapter)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# Core Orchestrator Service (apps/core)
# ------------------------------------------------------------------------------
GIT_ADAPTER_URL=http://adapter:8080
REVIEW_RESULTS_TOPIC=review-results
LLM_PROVIDER=gemini
REVIEW_MODEL=gemini-3.8-flash

# Google Gemini API Key (for Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# Google Cloud Project (Optional if running inside GCP compute environment)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ------------------------------------------------------------------------------
# Local Development & Emulators (Optional)
# ------------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=localhost:8081
# PUBSUB_EMULATOR_HOST=localhost:8085
# PUBSUB_PROJECT_ID=local-project
