{
  "name": "code-review-agent",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "lint": "NX_INTERACTIVE=false nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "NX_INTERACTIVE=false nx run-many -t typecheck",
    "test": "NX_INTERACTIVE=false nx run-many -t test",
    "e2e": "NX_INTERACTIVE=false nx run-many -t e2e",
    "build": "NX_INTERACTIVE=false nx run-many -t build",
    "docker:build:github-ingress": "docker build -f apps/github-ingress/Dockerfile -t code-review-agent-github-ingress .",
    "docker:build:github-adapter": "docker build -f apps/github-adapter/Dockerfile -t code-review-agent-github-adapter .",
    "docker:build:core": "docker build -f apps/core/Dockerfile -t code-review-agent-core ."
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@google/adk-devtools": "^2.5.0",
    "@nx/esbuild": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@swc/helpers": "~0.5.24",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "lefthook": "^2.2.2",
    "nx": "24.0.6",
    "prettier": "~3.10.1",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@google-cloud/pubsub": "^6.4.1",
    "@google/adk": "~2.5.0",
    "@google/genai": "^2.32.0",
    "@octokit/webhooks": "^14.2.0",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^6.0.3",
    "octokit": "^5.0.5",
    "tar": "^7.5.23",
    "zod": "^4.6.7"
  },
  "type": "module"
}
